# name: test/sql/elements.test
# description: SQL-level tests for the elements worker, run through DuckDB by ci/run-integration.sh
# group: [elements]

require vgi

require-env ELEMENTS_WORKER

statement ok
ATTACH 'elements' (TYPE vgi, LOCATION '{ELEMENTS_WORKER}');

# ---------------------------------------------------------------- elements table

query III
SELECT count(*), count(DISTINCT symbol), max(atomic_number) FROM elements.main.elements;
----
118	118	118

query TTRTT
SELECT symbol, name, atomic_mass, standard_atomic_weight, atomic_mass_basis
FROM elements.main.elements WHERE atomic_number IN (1, 6, 26, 43, 118) ORDER BY atomic_number;
----
H	Hydrogen	1.008	[1.00784,1.00811]	conventional_atomic_weight
C	Carbon	12.011	[12.0096,12.0116]	conventional_atomic_weight
Fe	Iron	55.845	55.845(2)	standard_atomic_weight
Tc	Technetium	97.9072124	[98]	longest_lived_isotope
Og	Oganesson	295.216	NULL	longest_lived_isotope

query IIITTT
SELECT group_number, period, oxidation_states[1], block, oxidation_states::VARCHAR, discovered_in_antiquity
FROM elements.main.elements WHERE symbol = 'Fe';
----
8	4	3	d	[3, 2]	true

query T
SELECT string_agg(symbol, ',' ORDER BY atomic_number) FROM elements.main.elements WHERE group_number = 18;
----
He,Ne,Ar,Kr,Xe,Rn,Og

query II
SELECT count(*) FILTER (group_number IS NULL), count(*) FILTER (block = 'f') FROM elements.main.elements;
----
30	30

query TI
SELECT standard_state, year_discovered FROM elements.main.elements WHERE symbol = 'Og';
----
Gas	2006

# Projection of a single column still works (SDK projection pushdown).
query R
SELECT sum(atomic_mass) > 10000 FROM elements.main.elements;
----
true

# ---------------------------------------------------------------- isotopes table

query I
SELECT count(*) FROM elements.main.isotopes;
----
3352

query TRR
SELECT nuclide, isotopic_composition, round(relative_atomic_mass, 6)
FROM elements.main.isotopes WHERE symbol = 'O' AND isotopic_composition IS NOT NULL ORDER BY mass_number;
----
O-16	0.99757	15.994915
O-17	0.00038	16.999132
O-18	0.00205	17.99916

query T
SELECT nuclide FROM elements.main.isotopes WHERE symbol = 'Fe' AND is_most_abundant;
----
Fe-56

query I
SELECT count(*) FROM elements.main.isotopes i JOIN elements.main.elements e USING (atomic_number) WHERE i.symbol <> e.symbol;
----
0

# ---------------------------------------------------------------- lookups

query TTTT
SELECT elements.main.element_symbol(26), elements.main.element_symbol(118), elements.main.element_symbol(0), elements.main.element_symbol(NULL::BIGINT);
----
Fe	Og	NULL	NULL

query TTTT
SELECT elements.main.element_name(26), elements.main.element_name('fe'), elements.main.element_name('aluminium'), elements.main.element_name('Xx');
----
Iron	Iron	Aluminum	NULL

query RRR
SELECT elements.main.atomic_mass(26), elements.main.atomic_mass('Fe'), elements.main.atomic_mass('carbon');
----
55.845	55.845	12.011

query IIII
SELECT elements.main.atomic_number('Fe'), elements.main.atomic_number('IRON'), elements.main.atomic_number('og'), elements.main.atomic_number('nope');
----
26	26	118	NULL

# Vectorized over a column.
query IT
SELECT z, elements.main.element_symbol(z) FROM range(116, 121) t(z) ORDER BY z;
----
116	Lv
117	Ts
118	Og
119	NULL
120	NULL

# ---------------------------------------------------------------- formula_mass

query TR
SELECT f, round(elements.main.formula_mass(f), 3)
FROM (VALUES ('H2O'), ('C9H8O4'), ('CuSO4·5H2O'), ('CuSO4*5H2O'), ('Ca(OH)2'), ('K4[Fe(CN)6]')) t(f) ORDER BY f;
----
C9H8O4	180.159
Ca(OH)2	74.092
CuSO4*5H2O	249.677
CuSO4·5H2O	249.677
H2O	18.015
K4[Fe(CN)6]	368.343

# Invalid input and NULL give NULL rather than failing the query.
query RRR
SELECT elements.main.formula_mass('h2o'), elements.main.formula_mass('H2O)'), elements.main.formula_mass(NULL);
----
NULL	NULL	NULL

# ---------------------------------------------------------------- formula_composition

query TIIR
SELECT element, atomic_number, count, round(mass_fraction, 4) FROM elements.main.formula_composition('C9H8O4') ORDER BY element;
----
C	6	9	0.6
H	1	8	0.0448
O	8	4	0.3552

query TI
SELECT element, count FROM elements.main.formula_composition('CuSO4·5H2O') ORDER BY element;
----
Cu	1
H	10
O	9
S	1

query R
SELECT round(sum(mass), 6) = round(elements.main.formula_mass('Al2(SO4)3'), 6) FROM elements.main.formula_composition('Al2(SO4)3');
----
true

statement error
SELECT * FROM elements.main.formula_composition('H2Q');
----
<REGEX>:.*unknown element symbol 'Q'.*

statement error
SELECT * FROM elements.main.formula_composition('');
----
<REGEX>:.*empty formula.*
